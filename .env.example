# Local development: copy this file to .env.local and replace AUTH_SECRET.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"

# Only required for a hosted PostgreSQL build. Configure these as Vercel
# environment variables, not in committed files. Keep local SQLite unchanged.
# DATABASE_URL is Neon's pooled URL (hostname contains -pooler).
# DATABASE_URL_UNPOOLED is the matching direct URL, used by Prisma 5 migrations.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require&connect_timeout=15"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&connect_timeout=15"
# AUTH_URL="https://your-production-domain.vercel.app"
# AUTH_TRUST_HOST="true"
