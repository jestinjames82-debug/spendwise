{
  "name": "spendwise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "next dev",
    "prebuild": "npm run db:generate",
    "build": "next build",
    "vercel-build": "npm run db:generate:production && npm run db:migrate:production && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:generate:production": "prisma generate --schema prisma/schema.production.prisma",
    "db:setup": "prisma db push --schema prisma/schema.prisma",
    "db:migrate:production": "prisma migrate deploy --schema prisma/schema.production.prisma",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
